  "port_policy": "Preserve exact electrical order. Local VDD/VSS map only to top VDD!/0. Do not short CDAC gates internally.",
  "proposed_faces": {
    "cdac": {
      "TOPN_TOPP": "north/centre, existing exits may require a separately verified change",
      "gates": "south/east toward reference",
      "VREFN_VREFP": "south/west"
    },
    "comparator": {
      "inputs": "south toward CDAC",
      "outputs_clock": "east toward SAR"
    },
    "bootstrap": {
      "VIN": "north",
      "TOP": "toward respective CDAC side",
      "clock": "outer digital side"
    },
    "reference": {
      "gates": "north toward CDAC switches",
      "code_controls": "east toward SAR"
    }
  },
  "routing_layers": {
    "status": "unassigned_until_native_pin_access_and_PDK_review",
    "permitted_by_net": null,
    "rule": "Retain existing M1-M7 CDAC geometry. New layer/via assignments require native rules, spacing and PEX verification; this plan grants no blanket layer permission."
  },
  "routes": {
    "TOPN": {
      "from": "XCDAC",
      "to": "XCOMP",
      "priority": 1,
      "intent": "short symmetric differential route; control fixed-potential parasitics"
    },
    "TOPP": {
      "from": "XCDAC",
      "to": "XCOMP",
      "priority": 1,
      "intent": "match TOPN topology; compare extracted C, not just length"
    },
    "sample_n": {
      "from": "XBOOTN",
      "to": "XCDAC",
      "priority": 1,
      "intent": "keep VIN/TOP and boosted nodes local; maintain body connections"
    },
    "sample_p": {
      "from": "XBOOTP",
      "to": "XCDAC",
      "priority": 1,
      "intent": "mirror N side geometrical intent"
    },
    "gates_32": {
      "from": "XREF",
      "to": "XCDAC",
      "priority": 2,
      "intent": "preserve gate interface and MSB D2 driver; validate actual switching, no assumed non-overlap"
    },
    "decision": {
      "from": "XCOMP",
      "to": "XCTRL",
      "priority": 2,
      "intent": "match COMP_N/COMP_P loads and preserve asynchronous handshake"
    },
    "compare_clock": {
      "from": "XCTRL",
      "to": "XCOMP",
      "priority": 2,
      "intent": "route away from TOP and VIN; retain actual CL_CMP_CLK load"
    }
  },
  "external_routes": {
    "VINN_VINP": "north analog entry, local to bootstrap",
    "VREFN_VREFP": "south/west dedicated distribution to CDAC",
    "SAMPLE_D0_D7": "east digital edge",
    "VDD_VSS": "perimeter straps and explicit local returns; isolation/guard topology pending"
  }
