// @RNL(author="saradc topology") {
// (-23,82) @TEXT("8-bit SAR / one token, eight bit stores, asynchronous handshake",size=1.5,halign="start",textcolor="#223d52");
// #XTIM @SET-SYMBOL $S_sar8p_timing;
// #XTIM @PLACE(0,39) => @ORIENT("R0");
// #XSEQ @SET-SYMBOL $S_sar8p_bitseq8;
