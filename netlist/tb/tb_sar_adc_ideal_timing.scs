// Library name: SAR_ADC_T28
// Cell name:    tb_sar_adc_ideal_timing
// View name:    netlist
simulator lang=spectre
global 0

Vvdd (vdd 0) vsource dc=900m type=dc
Vvss (vss 0) vsource type=dc
Vrefp (vrefp 0) vsource dc=900m type=dc
Vrefn (vrefn 0) vsource type=dc
Vrst (rst_n 0) vsource type=pwl wave=[ 0 0 5n 0 10n 900m 200n 900m ]
Vsample (clk_sample 0) vsource type=pulse val0=900m val1=0 delay=40n \
    rise=20p fall=20p width=60n period=100n
Vsar (clk_sar 0) vsource type=pulse val0=0 val1=900m delay=42.5n \
    rise=20p fall=20p width=2.5n period=5n
Vvinp (vinp 0) vsource type=pwl wave=[ 0 675m 50n 675m 60n 225.5m 200n 225.5m ]
Vvinn (vinn 0) vsource type=pwl wave=[ 0 225m 50n 225m 60n 674.5m 200n 674.5m ]

IADC (vinp vinn vrefp vrefn clk_sample clk_sar rst_n vdd vss \
    dout_9 dout_8 dout_7 dout_6 dout_5 dout_4 dout_3 dout_2 dout_1 dout_0 \
    busy valid) sar_adc_ideal_10b

simulatorOptions options reltol=1e-4 vabstol=1e-6 iabstol=1e-12 \
    temp=27 tnom=27 gmin=1e-12
tran tran stop=195n errpreset=conservative
save vinp vinn clk_sample clk_sar rst_n busy valid \
    dout_9 dout_8 dout_7 dout_6 dout_5 dout_4 dout_3 dout_2 dout_1 dout_0
ahdl_include "../../models/veriloga/sar_adc_ideal_10b.va"
