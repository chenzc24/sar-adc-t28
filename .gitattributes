# Input hashes bind exact bytes, including frozen Windows line endings.
design/** -text whitespace=cr-at-eol
tb/** -text whitespace=cr-at-eol
tools/** -text whitespace=cr-at-eol
specs/** -text whitespace=cr-at-eol
# Native receipts and plots retain their original formatting and hashes.
results/** -text -whitespace
.agents/** -text whitespace=cr-at-eol
docs/schematics/** -text whitespace=cr-at-eol
# Planning snapshots hash these checked-out JSON files byte for byte.
Layout/design/manifest.json text eol=lf
Layout/design/floorplan.json text eol=lf
Layout/design/io_ring.json text eol=lf
Layout/specs/interfaces.json text eol=lf
Layout/specs/constraints.json text eol=lf
