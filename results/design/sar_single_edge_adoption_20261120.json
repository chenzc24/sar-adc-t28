  "architecture": {
    "implementation": "design/xtor/sar/single_edge.scs",
    "master": "sar8_se_ctrl",
    "decisions_per_frame": 8,
    "rising_event_counts": {
      "cmp": 8,
      "write": 8
    },
    "event_order": "cmp[i] < write[i] < cmp[i+1]",
    "write_edge": "COMMIT is the only register clock; the next trial word is precomputed before DATA arrives",
    "first_compare": "No settling window: tracking precharges every tap high. LIVE waits for SN delayed by two DEL250 cells with an AN2 qualifier so the bootstrap gates are off.",
    "settling_window": {
      "delay_cell": "DEL250D1BWP12T30P140",
      "taps_by_compared_bit": {
        "6": 11,
        "5": 9,
        "4": 7,
        "3": 6,
        "2": 5,
        "1": 4,
        "0": 4
      },
      "select": "Five sticky registers, each set by the commit of the preceding trial bit and cleared by sampling. Within a frame a tap only becomes shorter.",
      "phase": "Two-flop Johnson counter; PHASE = PHA XOR PHB changes once per commit",
      "criterion": "Signed TOP error from all 510 switched plates against the nominal rails: <=0.25 LSB required, <=0.125 LSB target at every comparison"
    },
    "acquisition": "DEL200 with an AN2 qualifier and CKBD1 delays only the rising bootstrap enable",
    "preset": "PRESET = DONE OR SEQ_SAMPLE; DONE is registered on the eighth commit",
    "terminal_voltage_measures": "AN2 write gate with VALID on the inner input; INV+INV+ND2 for the sticky-select ORs and the reference MSB OR; two-flop phase register"
  },
