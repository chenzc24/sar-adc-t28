ahdl_include "r4_transition_stim.va"
tran_perf tran stop=32559n maxstep=10p errpreset=conservative lteratio=10 strobeperiod=1n strobeoutput=strobeonly
save D0 D1 D2 D3 D4 D5 D6 D7 SAMPLE VDD! XDUT.SAMPLE_INT XDUT.CMP_CLK XDUT.TOPP XDUT.TOPN VINP_SRC VINN_SRC
