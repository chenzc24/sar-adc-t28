include "dut.scs"
include "tb.scs"
simulatorOptions options psfversion="1.4.0" method=gear2only reltol=1e-6 vabstol=1e-8 \
    iabstol=1e-13 temp=125 tnom=27 scalem=1.0 scale=1.0 gmin=1e-12 rforce=1 \
    maxnotes=5 maxwarns=5 digits=5 cols=80 pivrel=1e-3 \
    checklimitdest=psf
saveOptions options save=selected

XSTIM (VINP_SRC VINN_SRC D0 D1 D2 D3 D4 D5 D6 D7) r4_transition_stim time_origin=59n first_k=36 last_k=67 warmup=4 refine=7 half_span_lsb=0.5
XMEASURE (XDUT.SAMPLE_INT XDUT.CMP_CLK XDUT.XCTRL.PHI_W XDUT.PHI_U XDUT.XREF.CAP_CLK VDD! VINP_SRC VINN_SRC XDUT.TOPP XDUT.TOPN D0 D1 D2 D3 D4 D5 D6 D7) r4_perf_monitor time_origin=59n
