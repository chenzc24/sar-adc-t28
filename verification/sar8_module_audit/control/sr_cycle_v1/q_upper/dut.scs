subckt sar8audit_timing ACTIVE CMP_CLK COMP_N COMP_P PHI_U PHI_W SAMPLE VDD VSS
    VREPLAY_DEC (DEC VSS) vsource type=pwl file="pwl/dec.pwl"
    X020 (Q1 LIVE VDD VSS QUIET) sar8audit_and2_tcb
    XD_QUIET_D (QUIET VDD VSS QUIET_D) sar8p_delay_quiet
    X022 (CYCLE_SET_A CYCLE_SET_B VDD VSS CLOCK_SET) sar8p_and2
    XCLOCK (CLOCK_Q CLOCK_RESET CLOCK_SET VDD VSS) sar8audit_sr_qborder
    X025 (CLOCK_Q VDD VSS CMP_CLK) sar8p_buf
    X015 (CMP_CLK VDD VSS CN) sar8p_inv
    X009 (DEC CMP_CLK VDD VSS WD) sar8p_and2
    X000 (SAMPLE VDD VSS SN) sar8p_inv
    X016 (PHI_W VDD VSS WN) sar8p_inv
    X017 (PHI_U VDD VSS UN) sar8p_inv
    X018 (CN WN VDD VSS Q0) sar8p_and2
    X019 (Q0 UN VDD VSS Q1) sar8p_and2
    X001 (SN ACTIVE VDD VSS LIVE) sar8audit_live_tcb
    X023 (CYCLE_RESET_A CYCLE_RESET_B VDD VSS CLOCK_RESET) sar8audit_or_resetnand_tcb
    X002 (COMP_P VDD VSS PR) sar8p_buf
    X003 (COMP_N VDD VSS NR) sar8p_buf
    VBIAS10_N (SNLOAD10_N VSS) vsource type=pwl file="pwl/bias_x010_n.pwl"
    VBIAS10_MID (SNLOAD10_MID VSS) vsource type=pwl file="pwl/bias_x010_mid.pwl"
    MSNLOAD10_MP1 (SNLOAD10_N SN VDD VDD) pch_mac l=30n w=1u multi=1 nf=1 sd=100n ad=7.5e-14 as=7.5e-14 pd=2.15u ps=2.15u nrd=0.165806 nrs=0.165806 sa=75.0n sb=75.0n sa1=75.0n sa2=75.0n sa3=75.0n sa4=75.0n sb1=75.0n sb2=75.0n sb3=75.0n spa=100n spa1=100n spa2=100n spa3=100n sap=91.9776n sapb=114.444n spba=115.715n spba1=117.043n dfm_flag=0 spmt=1.11111e+15 spomt=0 spomt1=1.11111e+60 spmb=1.11111e+15 spomb=0 spomb1=1.11111e+60
    MSNLOAD10_MN1 (SNLOAD10_MID SN VSS VSS) nch_mac l=30n w=1u multi=1 nf=1 sd=100n ad=7.5e-14 as=7.5e-14 pd=2.15u ps=2.15u nrd=0.289519 nrs=0.289519 sa=75.0n sb=75.0n sa1=75.0n sa2=75.0n sa3=75.0n sa4=75.0n sb1=75.0n sb2=75.0n sb3=75.0n spa=100n spa1=100n spa2=100n spa3=100n sap=91.9776n sapb=114.444n spba=115.715n spba1=117.043n dfm_flag=0 spmt=1.11111e+15 spomt=0 spomt1=1.11111e+60 spmb=1.11111e+15 spomb=0 spomb1=1.11111e+60
    VBIAS14_N (SNLOAD14_N VSS) vsource type=pwl file="pwl/bias_x014_n.pwl"
    VBIAS14_MID (SNLOAD14_MID VSS) vsource type=pwl file="pwl/bias_x014_mid.pwl"
