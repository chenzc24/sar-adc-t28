    VSR_SET_B (CYCLE_SET_B VSS) vsource type=pwl file="pwl/sr_set_b.pwl"
ends sar8audit_timing

subckt sar8audit_control ACTIVE CMP_CLK COMP_N COMP_P PHI_U SAMPLE VDD VSS
    VREPLAY_PHI_W (PHI_W VSS) vsource type=pwl file="pwl/phi_w.pwl"
    XTIM (ACTIVE CMP_CLK COMP_N COMP_P PHI_U PHI_W SAMPLE VDD VSS) sar8audit_timing
ends sar8audit_control

subckt sar8audit_ctrl_first_event VDD VSS
    VREPLAY_SAMPLE_INT (SAMPLE_INT VSS) vsource type=pwl file="pwl/sample_int.pwl"
    VREPLAY_PHI_U (PHI_U VSS) vsource type=pwl file="pwl/phi_u.pwl"
    VREPLAY_ACTIVE (ACTIVE VSS) vsource type=pwl file="pwl/active.pwl"
    VREPLAY_TOPP (TOPP VSS) vsource type=pwl file="pwl/topp.pwl"
    VREPLAY_TOPN (TOPN VSS) vsource type=pwl file="pwl/topn.pwl"
    XCTRL (ACTIVE CMP_CLK COMP_N COMP_P PHI_U SAMPLE_INT VDD VSS) sar8audit_control
    XCOMP (CMP_CLK COMP_N COMP_P VDD! TOPN TOPP 0) sar_strongarm_t28
    CL_COMP_P (COMP_P 0) cfmom_2t nr=8 lr=2.5u w=50n s=50n stm=1 spm=3  multi=2 mismatchflag=1
    CL_COMP_N (COMP_N 0) cfmom_2t nr=8 lr=2.5u w=50n s=50n stm=1 spm=3  multi=2 mismatchflag=1
    CL_CMP_CLK (CMP_CLK 0) cfmom_2t nr=8 lr=2.5u w=50n s=50n stm=1 spm=3  multi=2 mismatchflag=1
ends sar8audit_ctrl_first_event

subckt sar8audit_and2_tcb A B VDD VSS Y
    RINPUT (B A1_FILTER) rupolym l=17.13u w=1u m=1 multi=(1)
    X000 (A1_FILTER A N VDD VSS) ND2D1BWP12T30P140
    X001 (N Y VDD VSS) INVD1BWP12T30P140
ends sar8audit_and2_tcb

