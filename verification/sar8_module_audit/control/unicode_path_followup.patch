+try:
+    text_type = unicode
+except NameError:
+    text_type = str
+
+
+def fs_text(value):
+    if isinstance(value, text_type):
+        return value
+    return value.decode(sys.getfilesystemencoding() or 'utf-8')
+
+
+def checked_command(arguments):
+    # Python 2 argparse yields byte paths while JSON yields unicode. Normalize
+    # paths to text for filesystem operations and encode only at exec boundary.
+    if sys.version_info[0] < 3:
+        encoding = sys.getfilesystemencoding() or 'utf-8'
+        arguments = [x.encode(encoding) if isinstance(x, text_type) else x for x in arguments]
+    subprocess.check_call(arguments)
 
 
