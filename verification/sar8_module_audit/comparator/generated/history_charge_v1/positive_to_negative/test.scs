include "cdac_load.scs"
ahdl_include "initializer.va"
ahdl_include "history_charge.va"
    XDUT (TOPP TOPN SAMPLE_INT VDD! 0 D0 D1 D2 D3 D4 D5 D6 D7 CMP_CLK PHI_U) audit_history_feedback
    XCDAC (TOPN TOPP BOT_N BOT_P VREFN VREFP) audit_cdac_hold
VVDD (VDD! 0) vsource dc=SUP
VSAMPLE (SAMPLE_INT 0) vsource type=pwl wave=[0n SUP 20n SUP 20.1n 0 100n 0]
VINIT (CINIT 0) vsource type=pwl wave=[0n SUP 18n SUP 18.1n 0 100n 0]
VPREP (PREP 0) vsource dc=(0.45+HSIGN*0.028125)
VPREN (PREN 0) vsource dc=(0.45-HSIGN*0.028125)
VVCM (VCM 0) vsource dc=0.45
VREFLOW (VREFN 0) vsource dc=0
VREFHIGH (VREFP 0) vsource dc=0.9
VSENSE_P (TOPP HOLD_P) vsource dc=0
XINIT_P (HOLD_P PREP CINIT 0) cmp_charge_initializer ron=10 control_high=0.9
VSENSE_N (TOPN HOLD_N) vsource dc=0
XINIT_N (HOLD_N PREN CINIT 0) cmp_charge_initializer ron=10 control_high=0.9
COUT0 (D0 0) capacitor c=5f
COUT1 (D1 0) capacitor c=5f
COUT2 (D2 0) capacitor c=5f
COUT3 (D3 0) capacitor c=5f
COUT4 (D4 0) capacitor c=5f
COUT5 (D5 0) capacitor c=5f
COUT6 (D6 0) capacitor c=5f
COUT7 (D7 0) capacitor c=5f
simulatorOptions options temp=27 tnom=27 reltol=1e-6 vabstol=1e-8 iabstol=1e-13 method=gear2only
tran_feedback tran stop=100n maxstep=5p errpreset=conservative
saveOptions options save=selected currents=selected subcktiprobes=no useprobes=no
XHISTORY (BOT_P BOT_N HIST_MARK CMP_CLK PHI_U VDD! VCM 0) cmp_history_charge step_sign=(-HSIGN) amp_v=0.02911764705882353 delay_s=900p slew_s=200p
