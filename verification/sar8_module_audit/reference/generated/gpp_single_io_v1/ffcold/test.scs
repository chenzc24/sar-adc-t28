include "dut.scs"
XDUT (L0 SAMPLE CMP_CLK GNPDRV GPNDRV VINN VINP VREFN VREFP VDD! 0) sar8_realpre_unit
VVDD (VDD! 0) vsource dc=0.99
VSAMPLE (SAMPLE 0) vsource type=pulse val0=SUP val1=0 delay=41n rise=100p fall=100p width=59.9n period=100n
VL0 (L0 0) vsource type=pwl wave=[0 0.98999999999999999 4.2995000000000002e-08 0.98999999999999999 4.3005e-08 0 4.7995000000000001e-08 0 4.8004999999999999e-08 0.98999999999999999 5.2000000000000002e-08 0.98999999999999999]
VGNP (GNPDRV 0) vsource type=pwl wave=[0 0.98999999999999999 4.3994999999999998e-08 0.98999999999999999 4.4004999999999996e-08 0 4.6994999999999998e-08 0 4.7004999999999996e-08 0.98999999999999999 5.2000000000000002e-08 0.98999999999999999]
VGPN (GPNDRV 0) vsource type=pwl wave=[0 0 4.3994999999999998e-08 0 4.4004999999999996e-08 0.98999999999999999 4.6994999999999998e-08 0.98999999999999999 4.7004999999999996e-08 0 5.2000000000000002e-08 0]
VCMP (CMP_CLK 0) vsource dc=0
VVINN (VINN_SRC 0) vsource type=pwl wave=[0n 0.045 100.2n 0.045 100.3n 0.855 200.2n 0.855 200.3n 0.45 300.2n 0.45 300.3n 0.44912109375 400.2n 0.44912109375 400.3n 0.45087890625 500.2n 0.45087890625 500.3n 0.3884765625]
VVINP (VINP_SRC 0) vsource type=pwl wave=[0n 0.855 100.2n 0.855 100.3n 0.045 200.2n 0.045 200.3n 0.45 300.2n 0.45 300.3n 0.45087890625 400.2n 0.45087890625 400.3n 0.44912109375 500.2n 0.44912109375 500.3n 0.5115234375]
VREFLOW (VREFN_SRC 0) vsource dc=0 type=dc
VREFHIGH (VREFP_SRC 0) vsource dc=0.9 type=dc
RREFN (VREFN_SRC VREFN) resistor r=50
RREFP (VREFP_SRC VREFP) resistor r=50
RINN (VINN_SRC VINN) resistor r=50
RINP (VINP_SRC VINP) resistor r=50
CREFN (VREFN 0) capacitor c=4p
CREFP (VREFP 0) capacitor c=4p
simulatorOptions options temp=-40 tnom=27 method=gear2only reltol=1e-6 vabstol=1e-8 iabstol=1e-13 gmin=1e-12
saveOptions options save=selected currents=selected subcktiprobes=no useprobes=no
