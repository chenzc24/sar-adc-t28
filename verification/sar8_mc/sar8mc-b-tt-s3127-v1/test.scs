include "library_include.scs"
include "dut.scs"
include "tb.scs"
simulatorOptions options psfversion="1.4.0" method=gear2only reltol=1e-6 vabstol=1e-8 \
    iabstol=1e-13 temp=27 tnom=27 scalem=1.0 scale=1.0 gmin=1e-12 rforce=1 \
    maxnotes=5 maxwarns=5 digits=5 cols=80 pivrel=1e-3 \
    checklimitdest=psf
saveOptions options save=selected

XMEASURE (XDUT.SAMPLE_INT XDUT.CMP_CLK XDUT.XCTRL.PHI_W XDUT.PHI_U XDUT.XREF.CAP_CLK VDD! VINP_SRC VINN_SRC XDUT.TOPP XDUT.TOPN D0 D1 D2 D3 D4 D5 D6 D7) r4_perf_monitor time_origin=59n
ahdl_include "r4_perf_monitor.va"
mc montecarlo numruns=1 seed=3127 variations=mismatch sampling=standard donominal=no savemismatchparams=yes mismatchparamfile="mismatch.params" mismatchscalarfile="mismatch.values" savefamilyplots=yes savedatainseparatedir=yes {
tran_ab tran stop=1059n maxstep=10p errpreset=moderate lteratio=10
}
save D0 D1 D2 D3 D4 D5 D6 D7 SAMPLE VDD! VINP_SRC VINN_SRC VINP VINN VREFP VREFN XDUT.SAMPLE_INT XDUT.SEQ_SAMPLE XDUT.CMP_CLK XDUT.XCTRL.PHI_W XDUT.PHI_U XDUT.XREF.CAP_CLK XDUT.TOPP XDUT.TOPN XDUT.XBOOTP.G XDUT.XBOOTN.G XDUT.ACTIVE XDUT.COMP_P XDUT.COMP_N xdut.xbootp.btop xdut.xbootp.bbot xdut.xbootn.btop xdut.xbootn.bbot
