VVDD (SUP 0) vsource dc=0.9
VCLOCK (CLK 0) vsource type=pulse val0=0 val1=0.9 delay=2n rise=50p fall=50p width=1.95n period=5n
XCMP (CLK ON OP SUP VINN VINP 0) sar_strongarm_t28
XRXN (ON SUP 0 NR) sar8p_buf
XRXP (OP SUP 0 PR) sar8p_buf
XNRB (NR SUP 0 NRB) sar8p_inv
XDATA (PR NRB SUP 0 DATA) sar8p_and2
XRAW (PR NR SUP 0 RAW) sar8p_xor2
XDELAY (RAW SUP 0 RAW_D) sar8p_delay_valid
CDATA (DATA 0) capacitor c=5f
XSEARCH (VINP VINN OP ON PR NR CLK SUP 0) sar8_mc_comp_search
ahdl_include "comp_search.va"
CL_ON (ON 0) cfmom_2t nr=8 lr=2.5u w=50n s=50n stm=1 spm=3  multi=2 mismatchflag=1
CL_OP (OP 0) cfmom_2t nr=8 lr=2.5u w=50n s=50n stm=1 spm=3  multi=2 mismatchflag=1
mc montecarlo numruns=1 seed=4150 variations=mismatch sampling=standard donominal=no savemismatchparams=yes mismatchparamfile="mismatch.params" mismatchscalarfile="mismatch.values" savefamilyplots=yes savedatainseparatedir=yes {
comp_tran tran stop=109n maxstep=5p errpreset=conservative
}
save OP ON PR NR CLK VINP VINN XCMP.X XCMP.Y XCMP.TAIL
